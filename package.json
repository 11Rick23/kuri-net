{
	"name": "kuri-net",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "next dev",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run src/database/migrate.ts",
		"build": "next build",
		"start": "next start",
		"test": "bun test ./tests/unit",
		"test:e2e": "node node_modules/.bin/playwright test",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "tsc --noEmit",
		"check": "biome check . && tsc --noEmit && bun run test"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.4",
		"@better-auth/passkey": "1.7.4",
		"better-auth": "1.7.4",
		"dotenv": "^17.4.1",
		"drizzle-orm": "^0.45.2",
		"next": "16.3.5",
		"next-themes": "^0.4.6",
		"pdf-lib": "^1.17.1",
		"pg": "^8.20.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-icons": "^5.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@catppuccin/tailwindcss": "^1.0.0",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/postcss": "^4.2.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.0.0",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"drizzle-kit": "^0.31.10",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2"
	}
}
